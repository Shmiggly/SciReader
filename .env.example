# Copy to .env and adjust. Everything runs locally; no API keys.

# Local LLMs (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
NARRATOR_MODEL=qwen3.5:9b
VERIFIER_MODEL=gemma4:12b

# Where SciReader keeps its document cache, audio cache and reading state.
# Default: <repo>/.data
SCIREADER_DATA_DIR=
# Where app-managed models go (TTS voices etc.). Default: <data dir>/models
MODELS_DIR=

# Hugging Face cache (Kokoro and parser weights). Keep it off a full system drive.
HF_HOME=
# Set to 1 once models are downloaded so nothing touches the network at runtime.
HF_HUB_OFFLINE=1

# Backend port
SCIREADER_PORT=8765
